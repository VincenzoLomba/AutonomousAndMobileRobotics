#!/usr/bin/env python3
"""
Centralized system readiness node for Tiago project.

What this node DOES:
- Exposes a single service: /is_system_ready
- Aggregates a few operational-readiness checks that every FSM would otherwise duplicate

What this node DOES NOT do:
- It does NOT guarantee that a specific motion plan will succeed
- It does NOT guarantee that navigation goals are feasible
- It only says whether the infrastructure is up and ready to accept requests

Official references used to choose the checks below:

1) Nav2 state-estimation / TF requirements:
   - Nav2 expects at minimum the TF chain map -> odom -> base_link
   - The map->odom transform is provided by localization / SLAM
   - The odom->base_link transform is provided by odometry
   Docs:
   https://docs.nav2.org/concepts/index.html
   https://docs.nav2.org/setup_guides/odom/setup_odom_gz.html

2) Odometry requirements:
   - Nav2 requires odom -> base_link TF
   - Nav2 also requires nav_msgs/Odometry to be published
   Docs:
   https://docs.nav2.org/setup_guides/odom/setup_odom_gz.html

3) rclpy readiness APIs:
   - ActionClient.server_is_ready() only checks that an action server is ready to process requests
   - Client.service_is_ready() only checks that a service server is ready
   Docs:
   https://docs.ros.org/en/iron/p/rclpy/rclpy.action.client.html
   https://docs.ros.org/en/jazzy/p/rclpy/rclpy.client.html

4) TF availability check:
   - tf2_ros.Buffer.can_transform(...) checks whether a transform is possible
   Docs:
   https://docs.ros.org/en/rolling/p/tf2_ros_py/tf2_ros.buffer.html

5) ros2_control controller listing:
   - controller_manager exposes the ListControllers service
   Docs:
   https://docs.ros.org/en/iron/p/controller_manager_msgs/interfaces/srv/ListControllers.html
   https://docs.ros.org/en/humble/p/controller_manager_msgs/
"""

from typing import List, Tuple

import rclpy
from rclpy.node import Node
from rclpy.action import ActionClient
from rclpy.duration import Duration
from rclpy.time import Time

from std_srvs.srv import Trigger
from sensor_msgs.msg import JointState
from nav_msgs.msg import Odometry

from tf2_ros import Buffer, TransformListener

from controller_manager_msgs.srv import ListControllers
from tiago_exam_interfaces.action import TiagoArm


class SystemReadyNode(Node):
    def __init__(self) -> None:
        super().__init__("system_ready_node")

        # -----------------------------
        # Configuration / assumptions
        # -----------------------------
        # Keep these explicit and easy to change.
        self.odom_topic = "odom"
        self.joint_states_topic = "joint_states"
        self.target_frame = "odom"
        self.source_frame = "base_link"

        self.move_group_node_name = "move_group"
        self.controller_manager_list_service = "/controller_manager/list_controllers"
        self.required_active_controllers = {"arm_controller", "torso_controller"}

        self.tiago_arm_action_name = "tiago_arm_action"

        # -----------------------------
        # Internal state
        # -----------------------------
        self.last_joint_state_msg = None
        self.last_odom_msg = None

        # -----------------------------
        # TF listener
        # -----------------------------
        self.tf_buffer = Buffer()
        self.tf_listener = TransformListener(self.tf_buffer, self)

        # -----------------------------
        # Passive subscriptions
        # -----------------------------
        # We subscribe only to confirm that data is actually arriving, not because
        # this node needs to consume or process these messages deeply.
        self.joint_states_sub = self.create_subscription(
            JointState,
            self.joint_states_topic,
            self.joint_states_callback,
            10,
        )
        self.odom_sub = self.create_subscription(
            Odometry,
            self.odom_topic,
            self.odom_callback,
            10,
        )

        # -----------------------------
        # External interfaces to check
        # -----------------------------
        self.list_controllers_client = self.create_client(
            ListControllers,
            self.controller_manager_list_service,
        )
        self.tiago_arm_action_client = ActionClient(
            self,
            TiagoArm,
            self.tiago_arm_action_name,
        )

        # -----------------------------
        # Public service exposed by this node
        # -----------------------------
        self.is_system_ready_srv = self.create_service(
            Trigger,
            "is_system_ready",
            self.handle_is_system_ready,
        )

        self.get_logger().info("system_ready_node initialized and exposing /is_system_ready")

    # ------------------------------------------------------------------
    # Simple subscriptions: just remember whether data has arrived
    # ------------------------------------------------------------------
    def joint_states_callback(self, msg: JointState) -> None:
        self.last_joint_state_msg = msg

    def odom_callback(self, msg: Odometry) -> None:
        self.last_odom_msg = msg

    # ------------------------------------------------------------------
    # Readiness checks
    # ------------------------------------------------------------------
    def check_tf_odom_to_base(self) -> Tuple[bool, str]:
        """
        Check whether the TF transform odom -> base_link is available.

        Why:
        Nav2 requires the odom -> base_link transform from the odometry system.
        """
        ok = self.tf_buffer.can_transform(
            self.target_frame,
            self.source_frame,
            Time(),  # latest available transform
            timeout=Duration(seconds=0.0),  # non-blocking check
        )
        if ok:
            return True, "TF odom->base_link available"
        return False, "TF odom->base_link NOT available"

    def check_odom(self) -> Tuple[bool, str]:
        """
        Check odometry readiness.

        We use two simple signals:
        1) at least one publisher exists on the odom topic
        2) at least one odom message has been received by this node
        """
        publisher_count = self.count_publishers(self.odom_topic)
        if publisher_count <= 0:
            return False, "No publishers on odom"

        if self.last_odom_msg is None:
            return False, "odom publisher exists but no message received yet"

        return True, "odom available and messages received"

    def check_joint_states(self) -> Tuple[bool, str]:
        """
        Check that joint states are actually available.

        Why:
        Motion / MoveIt readiness without joint states is not trustworthy, since
        the robot state would be unknown or stale.
        """
        publisher_count = self.count_publishers(self.joint_states_topic)
        if publisher_count <= 0:
            return False, "No publishers on joint_states"

        if self.last_joint_state_msg is None:
            return False, "joint_states publisher exists but no message received yet"

        return True, "joint_states available and messages received"

    def check_move_group_node(self) -> Tuple[bool, str]:
        """
        Check that the MoveIt move_group node exists in the graph.

        This is an availability check only. It does NOT prove that a specific plan
        will succeed.
        """
        names_and_namespaces = self.get_node_names_and_namespaces()
        node_names = {name for name, _ns in names_and_namespaces}
        if self.move_group_node_name in node_names:
            return True, "move_group node exists"
        return False, "move_group node does NOT exist"

    def check_controllers(self) -> Tuple[bool, str]:
        """
        Check that controller_manager is up and that the required controllers are active.

        We query /controller_manager/list_controllers using the official
        controller_manager_msgs/srv/ListControllers service.
        """
        if not self.list_controllers_client.service_is_ready():
            return False, "/controller_manager/list_controllers not ready"

        req = ListControllers.Request()
        future = self.list_controllers_client.call_async(req)
        rclpy.spin_until_future_complete(self, future, timeout_sec=0.5)

        if not future.done():
            return False, "Timed out querying list_controllers"

        exc = future.exception()
        if exc is not None:
            return False, f"list_controllers call failed: {exc}"

        response = future.result()
        if response is None:
            return False, "list_controllers returned no response"

        states = {ctrl.name: ctrl.state for ctrl in response.controller}
        missing_or_inactive = [
            name for name in self.required_active_controllers
            if states.get(name) != "active"
        ]

        if missing_or_inactive:
            return False, (
                "Required controllers not active: " +
                ", ".join(sorted(missing_or_inactive))
            )

        return True, "Required motion controllers are active"

    def check_tiago_arm_action(self) -> Tuple[bool, str]:
        """
        Check that the custom TiagoArm action server is available.

        Important:
        server_is_ready() only means the action server is ready to process requests.
        It does NOT guarantee that every goal will succeed.
        """
        if self.tiago_arm_action_client.server_is_ready():
            return True, "tiago_arm_action server ready"
        return False, "tiago_arm_action server NOT ready"

    def compute_system_readiness(self) -> Tuple[bool, List[str]]:
        """
        Run all checks and return:
        - overall boolean
        - list of detailed messages
        """
        checks = [
            self.check_tf_odom_to_base(),
            self.check_odom(),
            self.check_joint_states(),
            self.check_move_group_node(),
            self.check_controllers(),
            self.check_tiago_arm_action(),
        ]

        all_ok = all(ok for ok, _msg in checks)
        messages = [msg for _ok, msg in checks]
        return all_ok, messages

    # ------------------------------------------------------------------
    # Public service callback
    # ------------------------------------------------------------------
    def handle_is_system_ready(
        self,
        request: Trigger.Request,
        response: Trigger.Response,
    ) -> Trigger.Response:
        del request

        all_ok, messages = self.compute_system_readiness()
        response.success = all_ok
        response.message = " | ".join(messages)
        return response


def main(args=None) -> None:
    rclpy.init(args=args)
    node = SystemReadyNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info("KeyboardInterrupt received, shutting down system_ready_node...")
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
