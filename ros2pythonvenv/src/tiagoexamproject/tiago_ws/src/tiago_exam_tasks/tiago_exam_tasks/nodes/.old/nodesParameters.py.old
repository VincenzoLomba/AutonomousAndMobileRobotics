@dataclass
class Task2LocationEstimate:
    found: bool
    marker_id: int
    label: str
    frame_id: str
    marker_frame: str
    sample_count: int
    position: Optional[Dict[str, float]]
    orientation: Optional[Dict[str, float]]

    @staticmethod
    def from_dict(data: Dict[str, Any], expected_label: str, expected_marker_id: int) -> "Task2LocationEstimate":
        required_base_fields = [
            "found",
            "marker_id",
            "label",
            "frame_id",
            "marker_frame",
            "sample_count",
        ]

        for field in required_base_fields:
            if field not in data:
                raise ValueError(f"Missing required field '{field}' in {expected_label} location estimate.")

        found = bool(data["found"])
        marker_id = int(data["marker_id"])
        label = str(data["label"])
        frame_id = str(data["frame_id"])
        marker_frame = str(data["marker_frame"])
        sample_count = int(data["sample_count"])

        if label != expected_label:
            raise ValueError(f"Expected label '{expected_label}', got '{label}'.")

        if marker_id != expected_marker_id:
            raise ValueError(f"Expected marker_id {expected_marker_id}, got {marker_id}.")

        position = None
        orientation = None

        if found:
            if "position" not in data:
                raise ValueError(f"Missing 'position' field in found {expected_label} location estimate.")
            if "orientation" not in data:
                raise ValueError(f"Missing 'orientation' field in found {expected_label} location estimate.")

            raw_position = data["position"]
            raw_orientation = data["orientation"]

            for key in ["x", "y", "z"]:
                if key not in raw_position:
                    raise ValueError(f"Missing position['{key}'] in {expected_label} location estimate.")

            for key in ["x", "y", "z", "w"]:
                if key not in raw_orientation:
                    raise ValueError(f"Missing orientation['{key}'] in {expected_label} location estimate.")

            position = {
                "x": float(raw_position["x"]),
                "y": float(raw_position["y"]),
                "z": float(raw_position["z"]),
            }

            orientation = {
                "x": float(raw_orientation["x"]),
                "y": float(raw_orientation["y"]),
                "z": float(raw_orientation["z"]),
                "w": float(raw_orientation["w"]),
            }

        return Task2LocationEstimate(
            found=found,
            marker_id=marker_id,
            label=label,
            frame_id=frame_id,
            marker_frame=marker_frame,
            sample_count=sample_count,
            position=position,
            orientation=orientation,
        )


@dataclass
class Task2LocationHistory:
    marker_id: int
    label: str
    frame_id: str
    marker_frame: str
    sample_count: int
    frames: List[Dict[str, Any]]

    @staticmethod
    def from_dict(data: Dict[str, Any], expected_label: str, expected_marker_id: int) -> "Task2LocationHistory":
        required_fields = [
            "marker_id",
            "label",
            "frame_id",
            "marker_frame",
            "sample_count",
            "frames",
        ]

        for field in required_fields:
            if field not in data:
                raise ValueError(f"Missing required field '{field}' in {expected_label} location history.")

        marker_id = int(data["marker_id"])
        label = str(data["label"])
        frame_id = str(data["frame_id"])
        marker_frame = str(data["marker_frame"])
        sample_count = int(data["sample_count"])
        frames = list(data["frames"])

        if label != expected_label:
            raise ValueError(f"Expected history label '{expected_label}', got '{label}'.")

        if marker_id != expected_marker_id:
            raise ValueError(f"Expected history marker_id {expected_marker_id}, got {marker_id}.")

        if sample_count != len(frames):
            raise ValueError(
                f"Inconsistent {expected_label} history: sample_count={sample_count}, len(frames)={len(frames)}."
            )

        return Task2LocationHistory(
            marker_id=marker_id,
            label=label,
            frame_id=frame_id,
            marker_frame=marker_frame,
            sample_count=sample_count,
            frames=frames,
        )


@dataclass
class Task2DiscoveryResults:
    pick: Task2LocationEstimate
    place: Task2LocationEstimate
    pick_history: Task2LocationHistory
    place_history: Task2LocationHistory

def load_json_file(savedMapPath: str, filename: str) -> dict:
    path = Path(savedMapPath) / filename

    if not path.exists():
        raise FileNotFoundError(f"Required Task2 discovery file not found: {path}")

    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def load_task2_discovery_results(savedMapPath: str) -> Task2DiscoveryResults:
    pickData = load_json_file(savedMapPath, "PickLocation.json")
    placeData = load_json_file(savedMapPath, "PlaceLocation.json")
    pickHistoryData = load_json_file(savedMapPath, "PickLocationHistory.json")
    placeHistoryData = load_json_file(savedMapPath, "PlaceLocationHistory.json")

    pick = Task2LocationEstimate.from_dict(
        pickData,
        expected_label="pick",
        expected_marker_id=26,
    )

    place = Task2LocationEstimate.from_dict(
        placeData,
        expected_label="place",
        expected_marker_id=238,
    )

    pickHistory = Task2LocationHistory.from_dict(
        pickHistoryData,
        expected_label="pick",
        expected_marker_id=26,
    )

    placeHistory = Task2LocationHistory.from_dict(
        placeHistoryData,
        expected_label="place",
        expected_marker_id=238,
    )

    if not pick.found:
        raise ValueError("Task2 pick location estimate was not found.")

    if not place.found:
        raise ValueError("Task2 place location estimate was not found.")

    return Task2DiscoveryResults(
        pick=pick,
        place=place,
        pick_history=pickHistory,
        place_history=placeHistory,
    )